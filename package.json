{
  "name": "venezia-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Website und digitale Speisekarte für Restaurant Venezia",
  "scripts": {
    "dev": "astro dev",
    "admin": "astro dev --open /keystatic",
    "build": "node scripts/validate-content.mjs && node scripts/generate-ar-models.mjs && astro build",
    "ar": "node scripts/generate-ar-models.mjs",
    "preview": "astro preview",
    "check": "node scripts/validate-content.mjs"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "dependencies": {
    "@astrojs/react": "4.4.2",
    "@astrojs/sitemap": "3.7.5",
    "@fontsource-variable/cormorant-garamond": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@gltf-transform/core": "4.5.1",
    "@keystatic/astro": "5.2.0",
    "@keystatic/core": "0.6.9",
    "@tailwindcss/vite": "4.3.5",
    "astro": "5.18.2",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5"
  }
}
