---
import { withBase } from '../lib/paths';
import Icon from './Icon.astro';
import { site, fullAddress, telHref, whatsappHref } from '../lib/content';
import { useT, LANGS, LANG_META, type Lang } from '../i18n/ui';
interface Props { lang: Lang; withBottomBar?: boolean }
const { lang, withBottomBar = true } = Astro.props;
const t = useT(lang);
const prefix = withBase(LANG_META[lang].path);
---
<footer class="footer">
  <div class="container-x footer-grid">
    <div>
      <p class="font-display text-3xl text-white">{site.name}</p>
      <p class="mt-1">{site.subtitle}</p>
      <p class="mt-3">{fullAddress()}<br /><a href={telHref(site.phone)}>{site.phone}</a></p>
    </div>
    <div>
      <p class="footer-h">{t('nav.menu')}</p>
      <ul>
        <li><a href={`${prefix}#speisekarte`}>{t('nav.menu')}</a></li>
        <li><a href={`${prefix}#allergene`}>{t('footer.allergens')}</a></li>
        <li><a href={`${prefix}#oeffnungszeiten`}>{t('nav.hours')}</a></li>
        <li><a href={withBase("/qr/")} class="inline-flex items-center gap-1.5"><Icon name="qr" class="w-4 h-4" />{t('footer.qr')}</a></li>
      </ul>
    </div>
    <div>
      <p class="footer-h">Info</p>
      <ul>
        <li><a href={withBase("/impressum/")}>{t('footer.imprint')}</a></li>
        <li><a href={withBase("/datenschutz/")}>{t('footer.privacy')}</a></li>
        <li class="flex gap-3">
          {LANGS.map((l) => <a href={withBase(LANG_META[l].path)} lang={LANG_META[l].locale} aria-current={l === lang ? 'page' : undefined}>{LANG_META[l].label}</a>)}
        </li>
      </ul>
    </div>
  </div>
  <div class="container-x mt-8 text-xs opacity-70">© {new Date().getFullYear()} {site.name}</div>
</footer>

{withBottomBar && (
  <div class="bottom-bar" data-bottom-bar>
    <a class="btn btn-call" href={telHref(site.phone)} aria-label={t('action.call')}><Icon name="phone" /></a>
    <a class="btn btn-primary" href={whatsappHref()} data-reserve><Icon name="whatsapp" />{t('action.reserve')}</a>
  </div>
)}
