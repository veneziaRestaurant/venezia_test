---
import { withBase } from '../lib/paths';
import Layout from '../layouts/Layout.astro';
import Footer from './Footer.astro';
import { site } from '../lib/content';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<Layout lang="de" title={`${title} – ${site.name}`} description={description}>
  <header style="background:var(--brand);color:#f6ecdc">
    <div class="container-x flex items-center justify-between" style="height:64px">
      <a href={withBase("/")} class="font-display text-2xl" style="text-decoration:none">← {site.name}</a>
    </div>
  </header>
  <main class="section">
    <article class="container-x legal">
      <h1>{title}</h1>
      <slot />
    </article>
  </main>
  <Footer lang="de" withBottomBar={false} />
</Layout>
